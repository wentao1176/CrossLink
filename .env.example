APP_ENV=production
DATABASE_URL=postgresql+psycopg://crosslink:CHANGE_ME@127.0.0.1:55432/crosslink
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE=1800
REFRESH_TOKEN_EXPIRE=2592000
FILE_STORAGE_PATH=/home/CrossLink/data/files
MAX_FILE_SIZE=104857600
FILE_RETENTION_SECONDS=604800
HEARTBEAT_TIMEOUT=90
# Docker Compose only: generate a distinct random password before use.
POSTGRES_PASSWORD=CHANGE_ME
