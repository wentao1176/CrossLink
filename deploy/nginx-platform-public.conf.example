pid /home/CrossLink/data/gateway/nginx.pid;
error_log /home/CrossLink/data/gateway/error.log warn;
worker_processes 1;
events { worker_connections 512; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /home/CrossLink/data/gateway/body;
  proxy_temp_path /home/CrossLink/data/gateway/proxy;
  fastcgi_temp_path /home/CrossLink/data/gateway/fastcgi;
  uwsgi_temp_path /home/CrossLink/data/gateway/uwsgi;
  scgi_temp_path /home/CrossLink/data/gateway/scgi;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 0.0.0.0:8443 ssl;
    server_name _;
    ssl_certificate /home/CrossLink/deploy/platform_tls/server.pem;
    ssl_certificate_key /home/CrossLink/deploy/platform_tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 101m;
    location / {
      proxy_pass http://127.0.0.1:8765;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_read_timeout 120s;
      proxy_request_buffering off;
      proxy_buffering off;
    }
  }
}
