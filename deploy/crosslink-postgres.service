[Unit]
Description=CrossLink private PostgreSQL
After=network.target
[Service]
User=postgres
Group=postgres
ExecStart=/usr/bin/postmaster -D /home/CrossLink/data/postgres -k /home/CrossLink/data/pgsocket -p 55432 -h 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/CrossLink/data/postgres /home/CrossLink/data/pgsocket
[Install]
WantedBy=multi-user.target
